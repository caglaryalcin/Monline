# Host port; the container listens on 3000.
PORT=3000
# Optional override for links in invitation, sharing and account emails.
# For local development, use the Vite address (for example http://localhost:3000).
# Leave empty to use the public server URL configured in administration.
MONLINE_PUBLIC_URL=
# Numeric owner of the persistent data directory.
PUID=1000
PGID=1000
TZ=Europe/Istanbul
# Set to 1 only when exactly one trusted reverse proxy fronts Monline.
TRUST_PROXY=0
# Existing encrypted legacy settings only: supply the old key for the first migration.
# Leave empty on new installations; remove it after a successful migration.
MONLINE_LEGACY_KEY=
